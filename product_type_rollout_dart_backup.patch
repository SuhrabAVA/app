diff --git a/lib/modules/warehouse/category_deletion_service.dart b/lib/modules/warehouse/category_deletion_service.dart
new file mode 100644
index 0000000..0f65a62
--- /dev/null
+++ b/lib/modules/warehouse/category_deletion_service.dart
@@ -0,0 +1,58 @@
+import '../../services/product_type_config_capability.dart';
+
+class CategoryCapabilityUnavailableException implements Exception {
+  const CategoryCapabilityUnavailableException();
+
+  @override
+  String toString() => productTypeCapabilityUnavailableMessage;
+}
+
+abstract class CategoryDeletionGateway {
+  Future<void> hardDelete(String categoryId);
+
+  Future<void> archiveAtomically({
+    required String categoryId,
+    String? reason,
+    String? deletedBy,
+  });
+
+  Future<void> writeLegacyAudit({
+    required String categoryId,
+    required Map<String, dynamic> payload,
+    String? reason,
+  });
+}
+
+class CategoryDeletionService {
+  const CategoryDeletionService(this._gateway);
+
+  final CategoryDeletionGateway _gateway;
+
+  Future<void> deleteOrArchive({
+    required ProductTypeConfigCapability capability,
+    required String categoryId,
+    required Map<String, dynamic> payload,
+    String? reason,
+    String? deletedBy,
+  }) async {
+    switch (capability) {
+      case ProductTypeConfigCapability.unknown:
+        throw const CategoryCapabilityUnavailableException();
+      case ProductTypeConfigCapability.disabled:
+        await _gateway.hardDelete(categoryId);
+        await _gateway.writeLegacyAudit(
+          categoryId: categoryId,
+          payload: payload,
+          reason: reason,
+        );
+        return;
+      case ProductTypeConfigCapability.enabled:
+        await _gateway.archiveAtomically(
+          categoryId: categoryId,
+          reason: reason,
+          deletedBy: deletedBy,
+        );
+        return;
+    }
+  }
+}
diff --git a/lib/modules/warehouse/warehouse_category_option.dart b/lib/modules/warehouse/warehouse_category_option.dart
new file mode 100644
index 0000000..b09cdc4
--- /dev/null
+++ b/lib/modules/warehouse/warehouse_category_option.dart
@@ -0,0 +1,49 @@
+class WarehouseCategoryOption {
+  const WarehouseCategoryOption({
+    required this.id,
+    required this.title,
+    required this.code,
+    this.archivedAt,
+  });
+
+  factory WarehouseCategoryOption.fromMap(Map<String, dynamic> map) {
+    final rawArchivedAt = map['archived_at'];
+    return WarehouseCategoryOption(
+      id: (map['id'] ?? '').toString(),
+      title: (map['title'] ?? map['code'] ?? '').toString().trim(),
+      code: (map['code'] ?? '').toString().trim(),
+      archivedAt: rawArchivedAt == null
+          ? null
+          : DateTime.tryParse(rawArchivedAt.toString()),
+    );
+  }
+
+  final String id;
+  final String title;
+  final String code;
+  final DateTime? archivedAt;
+
+  bool get isArchived => archivedAt != null;
+  String get displayTitle => isArchived ? '$title (Архивная)' : title;
+}
+
+List<WarehouseCategoryOption> activeCategoryOptions(
+  Iterable<WarehouseCategoryOption> categories,
+) =>
+    categories.where((category) => !category.isArchived).toList();
+
+List<WarehouseCategoryOption> categoryOptionsForOrder({
+  required Iterable<WarehouseCategoryOption> active,
+  WarehouseCategoryOption? current,
+}) {
+  final byId = <String, WarehouseCategoryOption>{
+    for (final category in active)
+      if (!category.isArchived) category.id: category,
+  };
+  if (current != null && !byId.containsKey(current.id)) {
+    byId[current.id] = current;
+  }
+  final result = byId.values.toList()
+    ..sort((a, b) => a.title.toLowerCase().compareTo(b.title.toLowerCase()));
+  return result;
+}
diff --git a/lib/services/product_type_config_capability.dart b/lib/services/product_type_config_capability.dart
new file mode 100644
index 0000000..e20cf24
--- /dev/null
+++ b/lib/services/product_type_config_capability.dart
@@ -0,0 +1,134 @@
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+import 'package:supabase_flutter/supabase_flutter.dart';
+
+enum ProductTypeConfigCapability {
+  unknown,
+  disabled,
+  enabled,
+}
+
+const productTypeCapabilityUnavailableMessage =
+    'Не удалось проверить возможности сервера. Повторите после восстановления связи';
+
+bool usesProductTypeConfigSchema(ProductTypeConfigCapability capability) =>
+    capability == ProductTypeConfigCapability.enabled;
+
+bool allowsLegacyCategoryDelete(ProductTypeConfigCapability capability) =>
+    capability == ProductTypeConfigCapability.disabled;
+
+bool allowsCategoryArchive(ProductTypeConfigCapability capability) =>
+    capability == ProductTypeConfigCapability.enabled;
+
+bool allowsCategoryDestructiveAction(ProductTypeConfigCapability capability) =>
+    capability != ProductTypeConfigCapability.unknown;
+
+abstract class ProductTypeConfigCapabilityRepository {
+  Future<bool> fetchEnabled();
+}
+
+class SupabaseProductTypeConfigCapabilityRepository
+    implements ProductTypeConfigCapabilityRepository {
+  SupabaseProductTypeConfigCapabilityRepository(this._client);
+
+  final SupabaseClient _client;
+
+  @override
+  Future<bool> fetchEnabled() async {
+    final row = await _client
+        .from('app_capabilities')
+        .select('enabled')
+        .eq('code', 'product_type_form_blocks_v1')
+        .single();
+    return row['enabled'] == true;
+  }
+}
+
+class ProductTypeConfigCapabilityProvider extends ChangeNotifier {
+  ProductTypeConfigCapabilityProvider(
+    this._repository, {
+    Stream<AuthState>? authChanges,
+    Stream<void>? appUserChanges,
+  }) {
+    _authSubscription = authChanges?.listen(_handleAuthStateChange);
+    _appUserSubscription = appUserChanges?.listen((_) {
+      invalidateForUserChange();
+    });
+  }
+
+  final ProductTypeConfigCapabilityRepository _repository;
+  StreamSubscription<AuthState>? _authSubscription;
+  StreamSubscription<void>? _appUserSubscription;
+
+  ProductTypeConfigCapability _capability = ProductTypeConfigCapability.unknown;
+  ProductTypeConfigCapability? _lastConfirmed;
+  Object? _lastError;
+  bool _isRefreshing = false;
+  bool _isStale = false;
+  int _requestGeneration = 0;
+
+  ProductTypeConfigCapability get capability => _capability;
+  ProductTypeConfigCapability? get lastConfirmed => _lastConfirmed;
+  Object? get lastError => _lastError;
+  bool get isRefreshing => _isRefreshing;
+  bool get isStale => _isStale;
+  bool get useNewSchema => usesProductTypeConfigSchema(_capability);
+  bool get destructiveCategoryActionsEnabled =>
+      allowsCategoryDestructiveAction(_capability);
+
+  Future<void> refresh() async {
+    final generation = ++_requestGeneration;
+    _isRefreshing = true;
+    _lastError = null;
+    notifyListeners();
+
+    try {
+      final enabled = await _repository.fetchEnabled();
+      if (generation != _requestGeneration) return;
+      _capability = enabled
+          ? ProductTypeConfigCapability.enabled
+          : ProductTypeConfigCapability.disabled;
+      _lastConfirmed = _capability;
+      _isStale = false;
+    } catch (error) {
+      if (generation != _requestGeneration) return;
+      _lastError = error;
+      _capability = ProductTypeConfigCapability.unknown;
+      _isStale = _lastConfirmed != null;
+    } finally {
+      if (generation == _requestGeneration) {
+        _isRefreshing = false;
+        notifyListeners();
+      }
+    }
+  }
+
+  void invalidateForUserChange({bool refreshImmediately = true}) {
+    _requestGeneration++;
+    _capability = ProductTypeConfigCapability.unknown;
+    _lastConfirmed = null;
+    _lastError = null;
+    _isStale = false;
+    _isRefreshing = false;
+    notifyListeners();
+    if (refreshImmediately) unawaited(refresh());
+  }
+
+  void _handleAuthStateChange(AuthState state) {
+    final event = state.event.name;
+    if (event == 'signedIn' ||
+        event == 'signedOut' ||
+        event == 'userUpdated' ||
+        event == 'userDeleted') {
+      invalidateForUserChange();
+    }
+  }
+
+  @override
+  void dispose() {
+    _authSubscription?.cancel();
+    _appUserSubscription?.cancel();
+    super.dispose();
+  }
+}
